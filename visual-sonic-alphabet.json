  "mapping_rules_summary": {
    "shape_to_timbre": {
      "circle": "simple harmonics (sine, triangle, bell)",
      "square": "rich harmonics (saw, square, complex)",
      "rectangle": "bass tones, sustained or plucked",
      "line": "drones, pads, or percussive clicks",
      "cross": "transient clicks, percussive",
      "grid": "FM synthesis, metallic tones",
      "wave": "rhythmic gates, arpeggios",
      "spiral": "modulated/rotating effects",
      "blob": "formant/vocal synthesis",
      "bracket": "physical modeling"
    },
    "brightness_to_pitch": {
      "formula": "midi = 36 + (brightness * 48)",
      "range": "MIDI 36 (C2) to 84 (C6)",
      "dark": "low bass frequencies",
      "bright": "high treble frequencies"
    },
    "size_to_duration": {
      "formula": "duration_ms = 100 + (size_px * 10)",
      "small": "short, staccato (100-300ms)",
      "medium": "moderate (300-800ms)",
      "large": "sustained (800-2400ms)"
    },
    "texture_to_complexity": {
      "smooth": "pure tones, low noise (texture < 0.3)",
      "grainy": "added noise, filtered (texture 0.3-0.7)",
      "complex": "granular, FM, multiple oscillators (texture > 0.7)"
    },
    "stroke_weight_to_amplitude": {
      "formula": "amplitude = 0.3 + (stroke_weight * 0.3)",
      "thin": "quiet, delicate",
      "thick": "loud, prominent"
    },
    "pattern_density_to_grain_count": {
      "sparse": "1-5 grains/notes",
      "medium": "10-20 grains/notes",
      "dense": "30-60 grains/notes"
    }
  },
  "frequency_band_definitions": {
    "sub_bass": {"range_hz": "20-60", "midi_range": "24-36", "visual_position": "bottom_10_percent"},
    "bass": {"range_hz": "60-250", "midi_range": "36-48", "visual_position": "bottom_20_percent"},
    "low_mid": {"range_hz": "250-500", "midi_range": "48-60", "visual_position": "lower_middle_30_percent"},
    "mid": {"range_hz": "500-2000", "midi_range": "60-72", "visual_position": "middle_40_percent"},
    "high_mid": {"range_hz": "2000-6000", "midi_range": "72-84", "visual_position": "upper_middle_60_percent"},
    "treble": {"range_hz": "6000-20000", "midi_range": "84-108", "visual_position": "top_20_percent"},
    "full_spectrum": {"range_hz": "20-20000", "midi_range": "24-108", "visual_position": "entire_height"}
  }
}
